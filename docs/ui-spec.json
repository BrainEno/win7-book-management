  "implementationRules": {
    "winFormsLayout": [
      "Use Dock/Anchor for shell regions.",
      "Use TableLayoutPanel for deterministic toolbar/form geometry.",
      "Use FlowLayoutPanel only where the spec explicitly permits wrapping.",
      "Avoid page-wide absolute Location/Size placement.",
      "Fixed logical sizes are allowed for stable controls defined by this spec.",
      "Apply MinimumSize / MaximumSize to columns and key controls according to this spec."
    ],
    "resizingPriority": [
      "Reduce page margins",
      "Reduce panel padding",
      "Reduce inter-control gaps",
      "Reduce button horizontal padding",
      "Compress flexible table columns to minWidth by shrinkPriority",
      "Wrap only at explicitly declared wrap points",
      "Hide optional helper text only where explicitly allowed",
      "Never hide primary actions",
      "Use table-local scrolling only below mandatory test sizes"
    ],
    "forbidden": [
      "Whole-page resolution-proportional scaling",
      "Global ScaleTransform / custom scale factor based on screen resolution",
      "Oversized cards or mobile-app spacing",
      "Large shadows, glassmorphism, complex gradients or 3D effects",
      "Page title larger than 20 logical px in standard/expanded profiles",
      "Input/select/date control height different from adjacent action button height",
      "Re-estimating any defined dimension from a prototype PNG",
      "Per-page top-right '本机离线' text/status",
      "Book Data '包含停用' checkbox/text",
      "Primary action hidden below viewport",
      "Workspace-level horizontal scrollbar at 1366x768 or larger"
    ]
  },
  "visualValidation": {
    "required": true,
    "referenceOwnership": "Approved prototype PNG per page and viewport",
    "requiredViewports": [
      {
        "width": 1366,
        "height": 768,
        "profile": "compact"
      },
      {
        "width": 1600,
        "height": 900,
        "profile": "standard"
      },
      {
        "width": 1920,
        "height": 1080,
        "profile": "standard"
      },
      {
        "width": 2560,
        "height": 1440,
        "profile": "expanded"
      }
    ],
    "capture": {
      "windowsScaling": "100% / 96 DPI for automated diff",
      "theme": "light",
      "windowState": "normal",
      "outerWindowSize": "exact required viewport",
      "automatedDiffCrop": "application client content region; exclude native OS frame/chrome",
      "dataFixture": "deterministic seeded fixture; identical records/order/content for reference and implementation",
      "cursorAndFocus": "hide mouse cursor; focus state must match reference",
      "animation": "disabled or settled before capture"
    },
    "process": [
      "Build Release or deterministic UI-test build.",
      "Launch with the fixed screenshot fixture/database.",
      "Set exact required viewport size.",
      "Navigate to the target page.",
      "Wait until layout, fonts and AntdUI animations are settled.",
      "Capture PNG.",
      "Crop to the defined client content region for automated comparison.",
      "Create 50% opacity overlay and absolute RGB diff image.",
      "Check geometry anchors before typography/color.",
      "Measure changed-pixel ratio using the configured RGB tolerance.",
      "Fail immediately on any zero-tolerance condition.",
      "Repeat for all four required viewports."
    ],
    "diffAlgorithm": {
      "mode": "absolute_rgb",
      "perChannelThreshold": 12,
      "overlayOpacity": 0.5,
      "ignoreAntiAliasedTextInterior": true,
      "doNotIgnore": [
        "text bounding boxes",
        "text baseline",
        "control edges",
        "panel edges",
        "table column separators",
        "button/input heights",
        "selected navigation geometry"
      ]
    },
    "geometryToleranceLogicalPx": {
      "criticalAnchors": 2,
      "nonCriticalSpacing": 3,
      "textBaseline": 2,
      "controlHeight": 1,
      "tableColumnSeparator": 2,
      "border": 1
    },
    "acceptance": {
      "maxChangedPixelRatioByViewport": {
        "1366x768": 0.02,
        "1600x900": 0.015,
        "1920x1080": 0.015,
        "2560x1440": 0.015
      },
      "criticalRegionMaxChangedPixelRatio": 0.005,
      "noClippedText": true,
      "noMissingPrimaryActions": true,
      "alignedToolbarBaselines": true,
      "inputAndAdjacentButtonSameHeight": true,
      "noWorkspaceHorizontalScrollAtOrAbove1366": true,
      "purchasePrimaryActionAlwaysVisible": true,
      "bookDataAllDeclaredColumnsVisibleAtMandatoryViewports": true
    },
    "artifactNaming": {
      "reference": "{page}.{width}x{height}.reference.png",
      "actual": "{page}.{width}x{height}.actual.png",
      "diff": "{page}.{width}x{height}.diff.png",
      "overlay": "{page}.{width}x{height}.overlay.png"
    }
  }
