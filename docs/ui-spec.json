{
  "$schema": "https://example.local/schemas/book-desk-ui-spec.schema.json",
  "specVersion": "1.1.1",
  "project": {
    "name": "BOOK DESK / 简易图书管理系统",
    "repository": "https://github.com/BrainEno/win7-book-management",
    "platform": "Windows Desktop",
    "framework": "C# WinForms",
    "runtime": ".NET Framework 4.8",
    "uiLibrary": "AntdUI",
    "windowsCompatibility": [
      "Windows 7",
      "Windows 10",
      "Windows 11"
    ],
    "purpose": "Single numeric source of truth for production WinForms/AntdUI geometry, spacing, responsive behavior, table sizing and screenshot-diff acceptance."
  },
  "sourceOfTruth": {
    "priority": [
      "ui-spec.json for every numeric geometry, spacing, responsive and component-size decision",
      "approved prototype PNGs for visual appearance / hierarchy / color verification",
      "current application code for business logic, data and behavior"
    ],
    "hardRule": "If a dimension or responsive behavior is defined in ui-spec.json, implementation MUST NOT re-estimate it from a screenshot. Prototype PNGs are visual references only.",
    "prototypeUsage": {
      "geometryInferenceAllowed": false,
      "visualValidationAllowed": true,
      "textAndBusinessStructureMayBeCrossChecked": true
    }
  },
  "measurement": {
    "unit": "logical_px_at_96_dpi",
    "coordinateSystem": "WinForms client logical pixels",
    "dpiPolicy": {
      "winFormsAutoScaleMode": "Dpi",
      "designDpi": 96,
      "autoScaleDimensions": [
        96,
        96
      ],
      "manifestDpiAwareness": "System DPI aware (Win7-compatible baseline)",
      "perMonitorV2Required": false,
      "breakpointsUseLogicalClientPixels": true,
      "layoutBeforeDpiScaling": true,
      "rules": [
        "Use AutoScaleMode.Dpi, not AutoScaleMode.Font, on shell/forms participating in the responsive system.",
        "Do not apply a custom global scale factor based on resolution.",
        "Do not multiply all coordinates, fonts, padding, control heights or column widths by screenWidth/referenceWidth.",
        "DPI scaling handles physical pixel density; responsive profiles handle available logical client area.",
        "Use Dock, Anchor, TableLayoutPanel and FlowLayoutPanel for responsive structure; avoid page-wide absolute coordinates.",
        "Test at 100%, 125% and 150% Windows scaling for clipping; geometry screenshot diff baseline is captured at 100% / 96 DPI."
      ],
      "win7Notes": [
        "Do not require PerMonitorV2 APIs for correctness.",
        "Changing monitor DPI while the process is running is not an acceptance requirement on Windows 7.",
        "All primary controls must remain readable and unclipped at common system DPI settings."
      ]
    },
    "pixelTolerance": {
      "baselineDpi": 96,
      "criticalGeometryLogicalPx": 2,
      "nonCriticalGeometryLogicalPx": 3,
      "textBaselineLogicalPx": 2,
      "controlHeightLogicalPx": 1,
      "tableColumnSeparatorLogicalPx": 2,
      "borderLogicalPx": 1,
      "colorChannelToleranceRgb": 12,
      "antiAliasedTextExclusion": true,
      "maxChangedPixelRatio": {
        "1366x768": 0.02,
        "1600x900": 0.015,
        "1920x1080": 0.015,
        "2560x1440": 0.015
      },
      "criticalRegionMaxChangedPixelRatio": 0.005,
      "zeroToleranceFailures": [
        "clipped text",
        "missing primary action",
        "overlapping controls",
        "wrong responsive profile",
        "workspace-level horizontal scrollbar at supported sizes",
        "search input and adjacent action button not equal height / baseline",
        "bottom primary purchase action not visible",
        "purchase header labels or controls clipped vertically",
        "purchase top toolbar button text clipped or rendered without usable padding"
      ]
    }
  },
  "viewports": {
    "testMatrix": [
      {
        "width": 1366,
        "height": 768,
        "profile": "compact",
        "captureName": "1366x768",
        "mandatory": true
      },
      {
        "width": 1600,
        "height": 900,
        "profile": "standard",
        "captureName": "1600x900",
        "mandatory": true
      },
      {
        "width": 1920,
        "height": 1080,
        "profile": "standard",
        "captureName": "1920x1080",
        "mandatory": true
      },
      {
        "width": 2560,
        "height": 1440,
        "profile": "expanded",
        "captureName": "2560x1440",
        "mandatory": true
      }
    ],
    "captureDimensionMeaning": "Target application window outer size for manual screenshots. Automated pixel diff MUST crop to the application client content region so native OS window chrome does not create false diffs.",
    "minimumSupportedClient": {
      "width": 1280,
      "height": 720,
      "policy": "Primary actions and key data may not clip. Whole-workspace horizontal scrolling is forbidden; table-local horizontal scrolling is last resort only below the mandatory 1366x768 test size."
    }
  },
  "tokens": {
    "color": {
      "appBackground": "#F5F7FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#FAFBFC",
      "sidebarBackground": "#F8FAFC",
      "border": "#E5EAF0",
      "borderStrong": "#D8DEE8",
      "textPrimary": "#1F2329",
      "textSecondary": "#667085",
      "textTertiary": "#98A2B3",
      "primary": "#1677FF",
      "primaryHover": "#4096FF",
      "primaryPressed": "#0958D9",
      "primarySoft": "#EAF4FF",
      "selectedNavBackground": "#E6F4FF",
      "selectedRowBackground": "#EAF4FF",
      "warning": "#FA8C16",
      "warningSoft": "#FFF7E6",
      "success": "#52C41A",
      "successSoft": "#F6FFED",
      "danger": "#FF4D4F",
      "disabledBackground": "#F5F5F5",
      "disabledText": "#B8B8B8",
      "infoSoft": "#EAF4FF",
      "infoBorder": "#91CAFF",
      "infoText": "#0958D9"
    },
    "typography": {
      "fontFamilyDesign": "Noto Sans SC",
      "fontFamilyWinForms": [
        "Microsoft YaHei",
        "Segoe UI"
      ],
      "rendering": "Prefer GDI/TextRenderer-compatible metrics for WinForms; do not mix font families on the same page.",
      "pageTitle": {
        "size": 20,
        "weight": 600,
        "lineHeight": 28
      },
      "sectionTitle": {
        "size": 16,
        "weight": 600,
        "lineHeight": 24
      },
      "body": {
        "size": 14,
        "weight": 400,
        "lineHeight": 22
      },
      "bodyStrong": {
        "size": 14,
        "weight": 600,
        "lineHeight": 22
      },
      "secondary": {
        "size": 12,
        "weight": 400,
        "lineHeight": 18
      },
      "tableHeader": {
        "size": 13,
        "weight": 600,
        "lineHeight": 20
      },
      "tableCell": {
        "size": 13,
        "weight": 400,
        "lineHeight": 20
      },
      "sidebarItem": {
        "size": 14,
        "weight": 500,
        "lineHeight": 22
      },
      "sidebarSection": {
        "size": 12,
        "weight": 600,
        "lineHeight": 18
      }
    },
    "radius": {
      "xs": 4,
      "sm": 6,
      "md": 8,
      "pill": 999
    },
    "spacing": {
      "xxs": 4,
      "xs": 6,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "xxl": 24
    },
    "border": {
      "width": 1,
      "focusWidth": 2
    },
    "control": {
      "standardHeight": 36,
      "compactHeight": 34,
      "expandedHeight": 36,
      "absoluteMinimumHeight": 32,
      "buttonHorizontalPadding": 14,
      "compactButtonHorizontalPadding": 10,
      "buttonMinWidth": 68,
      "inputHorizontalPadding": 12,
      "iconSize": 16,
      "checkboxSize": 18,
      "gap": 8,
      "sameHeightRule": "All inputs/selects/date controls and adjacent action buttons in one row use the profile controlHeight."
    },
    "table": {
      "headerHeight": 42,
      "rowHeight": 46,
      "compactHeaderHeight": 38,
      "compactRowHeight": 42,
      "expandedHeaderHeight": 42,
      "expandedRowHeight": 46,
      "cellPaddingX": 12,
      "compactCellPaddingX": 8,
      "cellPaddingY": 8,
      "gridLineWidth": 1
    },
    "shadow": {
      "enabled": false,
      "note": "Use border hierarchy instead of large web-style shadows. A very subtle 1px ambient shadow is allowed only where AntdUI already provides it."
    }
  },
  "appShell": {
    "windowTitleBar": {
      "height": 44,
      "appName": "简易图书管理系统  BOOK DESK",
      "background": "#F7FBFF"
    },
    "sidebar": {
      "width": 228,
      "compactWidth": 208,
      "expandedWidth": 232,
      "minWidth": 200,
      "maxWidth": 240,
      "horizontalPadding": 10,
      "topPadding": 14,
      "bottomStatusHeight": 72,
      "sectionLabelTopGap": 18,
      "sectionLabelBottomGap": 6,
      "itemHeight": 46,
      "itemRadius": 6,
      "itemHorizontalPadding": 12,
      "iconColumnWidth": 28,
      "selectedIndicatorWidth": 3,
      "scrollbarWidth": 6,
      "selectedBehavior": "Selected row background uses selectedNavBackground and a 3px primary left indicator."
    },
    "pageHeader": {
      "height": 64,
      "compactHeight": 56,
      "horizontalPadding": 16,
      "titleIconSize": 22,
      "titleIconGap": 10,
      "titleSize": 20,
      "compactTitleSize": 18,
      "statusControlWidth": 148,
      "statusControlHeight": 36,
      "expandedHeight": 64,
      "subtitleVisible": false,
      "rightPageStatusVisible": false,
      "note": "Do not render the per-page top-right text/status '本机离线'. Sidebar bottom offline state may remain."
    },
    "content": {
      "paddingX": 12,
      "paddingY": 12,
      "compactPaddingX": 10,
      "compactPaddingY": 8,
      "sectionGap": 12,
      "compactSectionGap": 8,
      "background": "#F5F7FA"
    },
    "footerStatusBar": {
      "height": 28,
      "horizontalPadding": 16,
      "fontSize": 11,
      "background": "#F8FAFC"
    }
  },
  "responsiveProfiles": {
    "compact": {
      "when": "clientWidth <= 1440 OR clientHeight <= 800",
      "mandatoryTestViewport": "1366x768",
      "sidebarWidth": 208,
      "pageHeaderHeight": 56,
      "pageTitleSize": 18,
      "contentPaddingX": 10,
      "contentPaddingY": 8,
      "sectionGap": 8,
      "controlHeight": 34,
      "buttonHorizontalPadding": 10,
      "controlGap": 6,
      "tableHeaderHeight": 38,
      "tableRowHeight": 42,
      "bodyFontSize": 13,
      "tableFontSize": 12,
      "secondaryFontSize": 11,
      "rules": [
        "Reduce margins/padding/gaps before reducing font size.",
        "Never reduce normal control height below 32 logical px.",
        "Primary actions never move below the viewport.",
        "Toolbar may wrap only at explicitly declared wrap points.",
        "Table columns shrink to minWidth by shrinkPriority before any table-local horizontal scroll.",
        "Do not hide business-critical columns unless the page explicitly defines a hide priority."
      ]
    },
    "standard": {
      "when": "1441 <= clientWidth < 2200 AND clientHeight > 800",
      "mandatoryTestViewports": [
        "1600x900",
        "1920x1080"
      ],
      "sidebarWidth": 228,
      "pageHeaderHeight": 64,
      "pageTitleSize": 20,
      "contentPaddingX": 12,
      "contentPaddingY": 12,
      "sectionGap": 12,
      "controlHeight": 36,
      "buttonHorizontalPadding": 14,
      "controlGap": 8,
      "tableHeaderHeight": 42,
      "tableRowHeight": 46,
      "bodyFontSize": 14,
      "tableFontSize": 13,
      "secondaryFontSize": 12
    },
    "expanded": {
      "when": "clientWidth >= 2200",
      "mandatoryTestViewport": "2560x1440",
      "sidebarWidth": 232,
      "pageHeaderHeight": 64,
      "pageTitleSize": 20,
      "contentPaddingX": 16,
      "contentPaddingY": 14,
      "sectionGap": 12,
      "controlHeight": 36,
      "buttonHorizontalPadding": 14,
      "controlGap": 8,
      "tableHeaderHeight": 42,
      "tableRowHeight": 46,
      "bodyFontSize": 14,
      "tableFontSize": 13,
      "secondaryFontSize": 12,
      "rules": [
        "Do not enlarge controls, fonts, sidebar or table row heights merely because more pixels are available.",
        "Give extra width to flexible search/table/detail regions.",
        "Use additional width to reduce truncation and expose more table content, not to create oversized whitespace."
      ]
    }
  },
  "components": {
    "toolbarCard": {
      "background": "#FFFFFF",
      "borderColor": "#E5EAF0",
      "borderWidth": 1,
      "radius": 8,
      "padding": 14,
      "compactPadding": 10
    },
    "searchInput": {
      "height": "$tokens.control.standardHeight",
      "radius": 6,
      "borderColor": "#D8DEE8",
      "focusBorderColor": "#1677FF",
      "focusRing": {
        "color": "#E6F4FF",
        "width": 2
      },
      "placeholderColor": "#A7AFBA",
      "minWidth": 260
    },
    "button": {
      "height": "$tokens.control.standardHeight",
      "radius": 6,
      "fontSize": 14,
      "minWidth": 68,
      "primary": {
        "background": "#1677FF",
        "foreground": "#FFFFFF"
      },
      "default": {
        "background": "#FFFFFF",
        "foreground": "#1F2329",
        "borderColor": "#D8DEE8"
      },
      "info": {
        "background": "#EAF4FF",
        "foreground": "#0958D9",
        "borderColor": "#91CAFF"
      }
    },
    "metricChip": {
      "height": 34,
      "compactHeight": 30,
      "radius": 4,
      "paddingX": 14,
      "gap": 6
    },
    "table": {
      "background": "#FFFFFF",
      "headerBackground": "#FAFBFC",
      "selectedBackground": "#EAF4FF",
      "borderColor": "#E5EAF0",
      "emptyState": {
        "iconSize": 56,
        "titleSize": 13,
        "bodySize": 12,
        "verticalGap": 6
      }
    }
  },
  "navigation": {
    "sections": [
      {
        "name": "工作台",
        "items": [
          "工作台"
        ]
      },
      {
        "name": "核心业务",
        "items": [
          "销售开单",
          "图书资料",
          "采购入库",
          "库存管理",
          "单据中心"
        ]
      },
      {
        "name": "经营管理",
        "items": [
          "供应商",
          "报表与导出"
        ]
      },
      {
        "name": "系统",
        "items": [
          "备份与恢复",
          "使用帮助",
          "系统设置"
        ]
      }
    ]
  },
  "pages": {
    "bookData": {
      "routeName": "图书资料",
      "selectedNav": "图书资料",
      "pageIconSize": 22,
      "layout": {
        "type": "vertical",
        "gap": 12,
        "toolbar": {
          "height": 104,
          "compactHeight": 92,
          "padding": 14,
          "compactPadding": 10,
          "rows": [
            {
              "name": "searchActions",
              "height": "$profile.controlHeight",
              "layout": "horizontal",
              "verticalAlign": "center",
              "baseline": "shared",
              "wrap": {
                "compact": "afterSearchInputOnlyIfRequired",
                "standard": "never",
                "expanded": "never"
              },
              "items": [
                {
                  "type": "label",
                  "text": "搜索",
                  "width": 48
                },
                {
                  "type": "input",
                  "name": "search",
                  "flex": 1,
                  "minWidth": 360,
                  "preferredWidth": 560,
                  "maxWidth": null,
                  "placeholder": "输入店内编码、ISBN、书名、作者或出版社",
                  "height": "$profile.controlHeight"
                },
                {
                  "type": "button",
                  "text": "查询",
                  "variant": "info",
                  "width": 78,
                  "minWidth": 72,
                  "height": "$profile.controlHeight"
                },
                {
                  "type": "button",
                  "text": "新增图书",
                  "variant": "primary",
                  "width": 118,
                  "minWidth": 108,
                  "height": "$profile.controlHeight"
                },
                {
                  "type": "button",
                  "text": "编辑资料",
                  "variant": "info",
                  "width": 110,
                  "minWidth": 104,
                  "height": "$profile.controlHeight"
                }
              ],
              "gap": "$profile.controlGap",
              "forbiddenItems": [
                "包含停用"
              ]
            },
            {
              "name": "summary",
              "height": 30,
              "compactHeight": 28,
              "topGap": 10,
              "items": [
                {
                  "type": "metric",
                  "textTemplate": "结果 {count}",
                  "tone": "primary",
                  "width": 96
                },
                {
                  "type": "metric",
                  "textTemplate": "低库存 {count}",
                  "tone": "warning",
                  "width": 112
                }
              ],
              "gap": 10
            }
          ]
        },
        "tableRegion": {
          "flex": 1,
          "minHeight": 300,
          "headerHeight": "$profile.tableHeaderHeight",
          "rowHeight": "$profile.tableRowHeight",
          "horizontalScrollPolicy": "forbidden_at_mandatory_viewports",
          "columnSizingAlgorithm": [
            "Start from preferred width.",
            "Allocate extra width to columns with flex > 0 by flex weight up to maxWidth.",
            "When width is constrained, shrink by shrinkPriority (1 shrinks first) down to minWidth.",
            "At mandatory viewports, every listed column remains visible; no column is hidden.",
            "If all columns are at minWidth, remaining surplus goes to title first, then author/publisher."
          ],
          "columns": [
            {
              "key": "storeCode",
              "title": "店内编码",
              "width": 108,
              "minWidth": 82,
              "maxWidth": 128,
              "flex": 0,
              "shrinkPriority": 8
            },
            {
              "key": "isbn",
              "title": "ISBN",
              "width": 110,
              "minWidth": 92,
              "maxWidth": 132,
              "flex": 0,
              "shrinkPriority": 9
            },
            {
              "key": "title",
              "title": "书名",
              "width": 200,
              "minWidth": 150,
              "maxWidth": 360,
              "flex": 3,
              "shrinkPriority": 2
            },
            {
              "key": "author",
              "title": "作者",
              "width": 116,
              "minWidth": 88,
              "maxWidth": 180,
              "flex": 1,
              "shrinkPriority": 3
            },
            {
              "key": "price",
              "title": "销售价格",
              "width": 98,
              "minWidth": 88,
              "maxWidth": 108,
              "flex": 0,
              "align": "right",
              "shrinkPriority": 10
            },
            {
              "key": "stock",
              "title": "库存",
              "width": 72,
              "minWidth": 62,
              "maxWidth": 80,
              "flex": 0,
              "align": "right",
              "shrinkPriority": 11
            },
            {
              "key": "publisher",
              "title": "出版社",
              "width": 112,
              "minWidth": 84,
              "maxWidth": 180,
              "flex": 1,
              "shrinkPriority": 4
            },
            {
              "key": "category",
              "title": "分类",
              "width": 92,
              "minWidth": 76,
              "maxWidth": 132,
              "flex": 1,
              "shrinkPriority": 1
            },
            {
              "key": "publishYear",
              "title": "出版年",
              "width": 82,
              "minWidth": 70,
              "maxWidth": 92,
              "flex": 0,
              "shrinkPriority": 6
            },
            {
              "key": "binding",
              "title": "装帧",
              "width": 74,
              "minWidth": 64,
              "maxWidth": 86,
              "flex": 0,
              "shrinkPriority": 5
            },
            {
              "key": "shelf",
              "title": "货架位",
              "width": 88,
              "minWidth": 74,
              "maxWidth": 124,
              "flex": 1,
              "shrinkPriority": 7
            },
            {
              "key": "enabled",
              "title": "启用",
              "width": 82,
              "minWidth": 72,
              "maxWidth": 92,
              "flex": 0,
              "shrinkPriority": 12
            }
          ]
        }
      },
      "responsive": {
        "compact": [
          "Toolbar may use two rows only if the first row cannot keep the search input >= 360px.",
          "If wrapped: row 1 = 搜索 + search input + 查询; row 2 = 新增图书 + 编辑资料, right aligned.",
          "Search input, 查询, 新增图书 and 编辑资料 always use the same profile controlHeight.",
          "Do not render '包含停用'.",
          "Reduce table columns to minWidth by shrinkPriority; do not hide columns at 1366x768.",
          "Search field gets remaining horizontal space before buttons gain extra width."
        ],
        "standard": [
          "Keep all search/actions on one row.",
          "Search input flexes first; buttons keep specified preferred widths.",
          "All 12 table columns remain visible without workspace horizontal scrolling."
        ],
        "expanded": [
          "Keep toolbar on one row.",
          "Grow title/author/publisher/category/shelf columns according to flex; do not enlarge fixed numeric/status columns."
        ]
      }
    },
    "purchaseReceiving": {
      "routeName": "采购入库",
      "selectedNav": "采购入库",
      "pageIconSize": 22,
      "layout": {
        "type": "vertical",
        "gap": 12,
        "topToolbar": {
          "height": 50,
          "compactHeight": 44,
          "paddingX": 0,
          "items": [
            {
              "type": "button",
              "text": "新入库单",
              "variant": "primary",
              "width": 118
            },
            {
              "type": "button",
              "text": "历史单据",
              "variant": "default",
              "width": 112
            },
            {
              "type": "button",
              "text": "上一张",
              "variant": "default",
              "width": 96
            },
            {
              "type": "button",
              "text": "下一张",
              "variant": "default",
              "width": 96
            },
            {
              "type": "button",
              "text": "导出 Excel",
              "variant": "default",
              "width": 118
            },
            {
              "type": "button",
              "text": "清空明细",
              "variant": "defaultDanger",
              "width": 118
            }
          ],
          "gap": "$profile.controlGap",
          "heightRule": "Top toolbar buttons use 42px standard/expanded and 40px compact, with explicit horizontal padding; text clipping is a zero-tolerance failure.",
          "buttonHeight": 42,
          "compactButtonHeight": 40,
          "buttonPaddingX": 12,
          "compactButtonPaddingX": 10
        },
        "documentCard": {
          "height": 92,
          "compactHeight": 80,
          "padding": 14,
          "compactPadding": 10,
          "row": {
            "height": 44,
            "verticalAlign": "center",
            "items": [
              {
                "type": "label",
                "text": "采购日期",
                "width": 82
              },
              {
                "type": "date",
                "name": "purchaseDate",
                "width": 206,
                "minWidth": 176,
                "height": 44,
                "compactHeight": 42
              },
              {
                "type": "label",
                "text": "采购单号",
                "width": 82
              },
              {
                "type": "input",
                "name": "documentNumber",
                "width": 258,
                "minWidth": 210,
                "placeholder": "留空时保存草稿会自动生成…",
                "height": 44,
                "compactHeight": 42
              },
              {
                "type": "label",
                "text": "供应商",
                "width": 70
              },
              {
                "type": "select",
                "name": "supplier",
                "flex": 0,
                "minWidth": 230,
                "preferredWidth": 320,
                "value": "不区分（默认）",
                "height": 44,
                "maxWidth": 380,
                "compactHeight": 42
              },
              {
                "type": "status",
                "name": "draftStatus",
                "text": "草稿",
                "width": 118,
                "height": 44,
                "tone": "primarySoft",
                "compactHeight": 42
              }
            ],
            "gap": "$profile.controlGap",
            "compactHeight": 42,
            "spacer": {
              "placement": "between supplier and status",
              "flex": 1,
              "minWidth": 12,
              "purpose": "Keep supplier bounded and push status to the right edge instead of stretching the supplier field."
            }
          }
        },
        "scanCard": {
          "height": 64,
          "compactHeight": 56,
          "padding": 10,
          "compactPadding": 8,
          "row": {
            "height": 44,
