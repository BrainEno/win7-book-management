{
  "$schema": "https://example.local/schemas/book-desk-ui-spec.schema.json",
  "specVersion": "1.0.0",
  "project": {
    "name": "BOOK DESK / 简易图书管理系统",
    "repository": "https://github.com/BrainEno/win7-book-management",
    "platform": "Windows Desktop",
    "framework": "C# WinForms",
    "runtime": ".NET Framework 4.8",
    "uiLibrary": "AntdUI",
    "windowsCompatibility": [
      "Windows 7",
      "Windows 10",
      "Windows 11"
    ],
    "purpose": "Machine-readable visual source of truth for high-fidelity implementation of four core desktop pages."
  },
  "sourceOfTruth": {
    "priority": [
      "ui-spec.json geometry, tokens, responsive rules",
      "approved prototype screenshots for visual appearance",
      "current application code for business logic and fields"
    ],
    "prototypeRaster": {
      "width": 1586,
      "height": 992,
      "aspectRatio": 1.59879,
      "usage": "Primary visual reference. Geometry below is normalized from this 1586x992 prototype family."
    },
    "rule": "Do not infer an existing numeric value from screenshots when the value exists in this spec. Screenshots are for visual validation, not dimension guessing."
  },
  "measurement": {
    "unit": "logical_px_at_96_dpi",
    "dpiPolicy": {
      "winFormsAutoScaleMode": "Dpi",
      "breakpointsUseLogicalClientPixels": true,
      "doNot": [
        "Scale the entire UI uniformly by screen resolution",
        "Multiply all dimensions by a custom resolution factor",
        "Use fixed absolute coordinates for the whole page"
      ],
      "guidance": "Use Dock/Anchor/TableLayoutPanel/FlowLayoutPanel and DPI-aware logical dimensions. DPI handles physical scaling; responsive rules handle layout."
    },
    "pixelTolerance": {
      "referenceViewport": 2,
      "otherSupportedViewports": 4,
      "textBaseline": 2,
      "controlHeight": 1,
      "note": "Tolerance is in logical pixels. Differences caused by font rasterization are excluded if geometry is correct."
    }
  },
  "viewports": {
    "reference": {
      "name": "Reference",
      "width": 1586,
      "height": 992,
      "layoutProfile": "standard"
    },
    "testMatrix": [
      {
        "width": 1366,
        "height": 768,
        "profile": "compact"
      },
      {
        "width": 1600,
        "height": 900,
        "profile": "standard"
      },
      {
        "width": 1920,
        "height": 1080,
        "profile": "standard"
      },
      {
        "width": 2560,
        "height": 1440,
        "profile": "expanded"
      }
    ],
    "minimumSupportedClient": {
      "width": 1280,
      "height": 720,
      "policy": "No clipping of primary actions or key data. Horizontal scrolling is a last resort and should be limited to data tables only."
    }
  },
  "tokens": {
    "color": {
      "appBackground": "#F5F7FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#FAFBFC",
      "sidebarBackground": "#F8FAFC",
      "border": "#E5EAF0",
      "borderStrong": "#D8DEE8",
      "textPrimary": "#1F2329",
      "textSecondary": "#667085",
      "textTertiary": "#98A2B3",
      "primary": "#1677FF",
      "primaryHover": "#4096FF",
      "primaryPressed": "#0958D9",
      "primarySoft": "#EAF4FF",
      "selectedNavBackground": "#E6F4FF",
      "selectedRowBackground": "#EAF4FF",
      "warning": "#FA8C16",
      "warningSoft": "#FFF7E6",
      "success": "#52C41A",
      "successSoft": "#F6FFED",
      "danger": "#FF4D4F",
      "disabledBackground": "#F5F5F5",
      "disabledText": "#B8B8B8"
    },
    "typography": {
      "fontFamilyDesign": "Noto Sans SC",
      "fontFamilyWinForms": [
        "Microsoft YaHei",
        "Segoe UI"
      ],
      "rendering": "Prefer GDI/TextRenderer-compatible metrics for WinForms; do not mix font families on the same page.",
      "pageTitle": {
        "size": 20,
        "weight": 600,
        "lineHeight": 28
      },
      "sectionTitle": {
        "size": 16,
        "weight": 600,
        "lineHeight": 24
      },
      "body": {
        "size": 14,
        "weight": 400,
        "lineHeight": 22
      },
      "bodyStrong": {
        "size": 14,
        "weight": 600,
        "lineHeight": 22
      },
      "secondary": {
        "size": 12,
        "weight": 400,
        "lineHeight": 18
      },
      "tableHeader": {
        "size": 13,
        "weight": 600,
        "lineHeight": 20
      },
      "tableCell": {
        "size": 13,
        "weight": 400,
        "lineHeight": 20
      },
      "sidebarItem": {
        "size": 14,
        "weight": 500,
        "lineHeight": 22
      },
      "sidebarSection": {
        "size": 12,
        "weight": 600,
        "lineHeight": 18
      }
    },
    "radius": {
      "xs": 4,
      "sm": 6,
      "md": 8,
      "pill": 999
    },
    "spacing": {
      "xxs": 4,
      "xs": 6,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "xxl": 24
    },
    "border": {
      "width": 1,
      "focusWidth": 2
    },
    "control": {
      "standardHeight": 36,
      "compactHeight": 34,
      "expandedHeight": 36,
      "buttonHorizontalPadding": 14,
      "buttonMinWidth": 68,
      "inputHorizontalPadding": 12,
      "iconSize": 16,
      "checkboxSize": 18,
      "gap": 8
    },
    "table": {
      "headerHeight": 42,
      "rowHeight": 46,
      "compactHeaderHeight": 38,
      "compactRowHeight": 42,
      "cellPaddingX": 12,
      "cellPaddingY": 8,
      "gridLineWidth": 1
    },
    "shadow": {
      "enabled": false,
      "note": "Use border hierarchy instead of large web-style shadows. A very subtle 1px ambient shadow is allowed only where AntdUI already provides it."
    }
  },
  "appShell": {
    "windowTitleBar": {
      "height": 44,
      "appName": "简易图书管理系统  BOOK DESK",
      "background": "#F7FBFF"
    },
    "sidebar": {
      "width": 228,
      "compactWidth": 208,
      "expandedWidth": 232,
      "minWidth": 200,
      "maxWidth": 240,
      "horizontalPadding": 10,
      "topPadding": 14,
      "bottomStatusHeight": 72,
      "sectionLabelTopGap": 18,
      "sectionLabelBottomGap": 6,
      "itemHeight": 46,
      "itemRadius": 6,
      "itemHorizontalPadding": 12,
      "iconColumnWidth": 28,
      "selectedIndicatorWidth": 3,
      "scrollbarWidth": 6,
      "selectedBehavior": "Selected row background uses selectedNavBackground and a 3px primary left indicator."
    },
    "pageHeader": {
      "height": 64,
      "compactHeight": 56,
      "horizontalPadding": 16,
      "titleIconSize": 22,
      "titleIconGap": 10,
      "titleSize": 20,
      "compactTitleSize": 18,
      "statusControlWidth": 148,
      "statusControlHeight": 36
    },
    "content": {
      "paddingX": 12,
      "paddingY": 12,
      "compactPaddingX": 10,
      "compactPaddingY": 8,
      "sectionGap": 12,
      "compactSectionGap": 8,
      "background": "#F5F7FA"
    },
    "footerStatusBar": {
      "height": 28,
      "horizontalPadding": 16,
      "fontSize": 11,
      "background": "#F8FAFC"
    }
  },
  "responsiveProfiles": {
    "compact": {
      "when": "clientWidth <= 1440 OR clientHeight <= 800",
      "sidebarWidth": 208,
      "pageHeaderHeight": 56,
      "pageTitleSize": 18,
      "contentPaddingX": 10,
      "contentPaddingY": 8,
      "sectionGap": 8,
      "controlHeight": 34,
      "buttonHorizontalPadding": 10,
      "controlGap": 6,
      "tableHeaderHeight": 38,
      "tableRowHeight": 42,
      "bodyFontSize": 13,
      "tableFontSize": 12,
      "secondaryFontSize": 11,
      "rules": [
        "Shrink margins and gaps before reducing font size.",
        "Never shrink standard controls below 32px height.",
        "Toolbar actions may wrap to a second row if required.",
        "Long helper text may collapse to one line or hide when explicitly marked optional.",
        "Tables should compress flexible columns before enabling horizontal scroll.",
        "Primary actions must remain visible without scrolling."
      ]
    },
    "standard": {
      "when": "1441 <= clientWidth < 2200 AND clientHeight > 800",
      "sidebarWidth": 228,
      "pageHeaderHeight": 64,
      "pageTitleSize": 20,
      "contentPaddingX": 12,
      "contentPaddingY": 12,
      "sectionGap": 12,
      "controlHeight": 36,
      "buttonHorizontalPadding": 14,
      "controlGap": 8,
      "tableHeaderHeight": 42,
      "tableRowHeight": 46,
      "bodyFontSize": 14,
      "tableFontSize": 13,
      "secondaryFontSize": 12
    },
    "expanded": {
      "when": "clientWidth >= 2200",
      "sidebarWidth": 232,
      "pageHeaderHeight": 64,
      "pageTitleSize": 20,
      "contentPaddingX": 16,
      "contentPaddingY": 14,
      "sectionGap": 12,
      "controlHeight": 36,
      "buttonHorizontalPadding": 14,
      "controlGap": 8,
      "tableHeaderHeight": 42,
      "tableRowHeight": 46,
      "bodyFontSize": 14,
      "tableFontSize": 13,
      "secondaryFontSize": 12,
      "rules": [
        "Do not scale buttons, row heights, sidebar, or fonts indefinitely.",
        "Give additional width to search fields, tables, and content panes.",
        "Use the extra width to reduce truncation rather than increasing whitespace."
      ]
    }
  },
  "components": {
    "toolbarCard": {
      "background": "#FFFFFF",
      "borderColor": "#E5EAF0",
      "borderWidth": 1,
      "radius": 8,
      "padding": 14,
      "compactPadding": 10
    },
    "searchInput": {
      "height": "$tokens.control.standardHeight",
      "radius": 6,
      "borderColor": "#D8DEE8",
      "focusBorderColor": "#1677FF",
      "focusRing": {
        "color": "#E6F4FF",
        "width": 2
      },
      "placeholderColor": "#A7AFBA",
      "minWidth": 260
    },
    "button": {
      "height": "$tokens.control.standardHeight",
      "radius": 6,
      "fontSize": 14,
      "minWidth": 68,
      "primary": {
        "background": "#1677FF",
        "foreground": "#FFFFFF"
      },
      "default": {
        "background": "#FFFFFF",
        "foreground": "#1F2329",
        "borderColor": "#D8DEE8"
      }
    },
    "metricChip": {
      "height": 34,
      "compactHeight": 30,
      "radius": 4,
      "paddingX": 14,
      "gap": 6
    },
    "table": {
      "background": "#FFFFFF",
      "headerBackground": "#FAFBFC",
      "selectedBackground": "#EAF4FF",
      "borderColor": "#E5EAF0",
      "emptyState": {
        "iconSize": 56,
        "titleSize": 13,
        "bodySize": 12,
        "verticalGap": 6
      }
    }
  },
  "navigation": {
    "sections": [
      {
        "name": "工作台",
        "items": [
          "工作台",
          "经营概览"
        ]
      },
      {
        "name": "核心业务",
        "items": [
          "销售开单",
          "图书资料",
          "采购入库",
          "库存管理",
          "单据中心"
        ]
      },
      {
        "name": "经营管理",
        "items": [
          "供应商",
          "报表与导出"
        ]
      },
      {
        "name": "系统",
        "items": [
          "备份与恢复",
          "使用帮助",
          "系统设置"
        ]
      }
    ]
  },
  "pages": {
    "bookData": {
      "routeName": "图书资料",
      "selectedNav": "图书资料",
      "pageIconSize": 22,
      "layout": {
        "type": "vertical",
        "gap": 12,
        "toolbar": {
          "height": 138,
          "compactHeight": 116,
          "padding": 14,
          "compactPadding": 10,
          "rows": [
            {
              "name": "searchActions",
              "height": 36,
              "layout": "horizontal",
              "items": [
                {
                  "type": "label",
                  "text": "搜索",
                  "width": 56
                },
                {
                  "type": "input",
                  "name": "search",
                  "flex": 1,
                  "minWidth": 360,
                  "placeholder": "输入店内编码、ISBN、书名、作者或出版社"
                },
                {
                  "type": "button",
                  "text": "查询",
                  "width": 72
                },
                {
                  "type": "button",
                  "text": "新增图书",
                  "variant": "primary",
                  "width": 124
                },
                {
                  "type": "button",
                  "text": "编辑资料",
                  "width": 116
                },
                {
                  "type": "checkbox",
                  "text": "包含停用",
                  "width": 102
                }
              ],
              "gap": 8
            },
            {
              "name": "summary",
              "height": 34,
              "topGap": 14,
              "items": [
                {
                  "type": "metric",
                  "text": "结果 1",
