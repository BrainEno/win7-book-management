                "title": "书名",
                "width": 180,
                "minWidth": 140,
                "flex": 2
              },
              {
                "key": "author",
                "title": "作者",
                "width": 112,
                "minWidth": 92
              },
              {
                "key": "category",
                "title": "分类",
                "width": 96,
                "minWidth": 82
              },
              {
                "key": "shelf",
                "title": "货架位",
                "width": 100,
                "minWidth": 84
              },
              {
                "key": "stock",
                "title": "当前库存",
                "width": 100,
                "minWidth": 90,
