                  "width": 96
                },
                {
                  "type": "metric",
                  "text": "低库存 1",
                  "tone": "warning",
                  "width": 112
                }
              ],
              "gap": 12
            }
          ]
        },
        "tableRegion": {
          "flex": 1,
          "minHeight": 300,
          "horizontalScrollPolicy": "last_resort",
          "columns": [
            {
              "key": "storeCode",
              "title": "店内编码",
