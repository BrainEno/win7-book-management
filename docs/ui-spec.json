              "flex": 0
            }
          ]
        }
      },
      "responsive": {
        "compact": [
          "Toolbar row may wrap after the search input.",
          "Search input stays on the first row and remains at least 360px wide.",
          "Action buttons use compact height 34 and horizontal padding 10.",
          "Metric row top gap reduces to 10.",
          "Reduce table flexible columns first: title, author, publisher, category, shelf.",
          "Do not hide columns at 1366x768."
        ]
      }
    },
    "purchaseReceiving": {
      "routeName": "采购入库",
      "selectedNav": "采购入库",
      "pageIconSize": 22,
      "layout": {
        "type": "vertical",
        "gap": 12,
        "toolbar": {
          "height": 148,
